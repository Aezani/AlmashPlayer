<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- الخلفية العلوية -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <ImageView
                android:id="@+id/imgBackdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:alpha="0.5" />

            <ImageView
                android:id="@+id/imgPoster"
                android:layout_width="120dp"
                android:layout_height="180dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="16dp"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <!-- النصوص الأساسية -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/txtYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtContentRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="14sp" />
            </LinearLayout>

            <RatingBar
                android:id="@+id/ratingBar"
                style="@android:style/Widget.Material.RatingBar.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:numStars="5"
                android:stepSize="0.5" />

            <TextView
                android:id="@+id/txtGenres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtTagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@android:color/holo_orange_light"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <!-- أزرار تشغيل وتحميل الفيلم -->
            <LinearLayout
                android:id="@+id/layoutMovieActions"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:gravity="start">

                <ImageButton
                    android:id="@+id/btnPlayMovie"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/play_circle_red"
                    android:src="@android:drawable/ic_media_play"
                    android:tint="@android:color/white"
                    android:scaleType="centerInside"
                    android:contentDescription="تشغيل" />

                <ImageButton
                    android:id="@+id/btnDownloadMovie"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:src="@android:drawable/stat_sys_download_done"
                    android:tint="@android:color/white"
                    android:scaleType="centerInside"
                    android:contentDescription="تحميل" />
            </LinearLayout>

        </LinearLayout>

        <!-- قسم الممثلين -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="طاقم التمثيل"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCast"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- قسم الأفلام المشابهة -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="أفلام مشابهة"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSimilar"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
