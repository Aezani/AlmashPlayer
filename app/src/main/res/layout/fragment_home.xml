<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- المحتوى الرئيسي للـ Home -->
    <LinearLayout
        android:id="@+id/contentRoot"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <!-- Hero أعلى الصفحة -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp">

            <ImageView
                android:id="@+id/imgHero"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher" />

            <!-- تدرّج غامق أسفل الصورة لقراءة النص -->
            <View
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_gravity="bottom"
                android:background="@android:color/transparent" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtHeroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="The Way Out (2022)"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white" />

                <TextView
                    android:id="@+id/txtHeroSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="وصف قصير للفيلم أو المسلسل"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/btnHeroPlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="شاهد الآن"
                    android:textAllCaps="false"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#E50914"
                    android:textColor="@android:color/white" />
            </LinearLayout>

        </FrameLayout>

        <!-- قائمة الصفوف (أفقي داخل عمودي) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerHomeRows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="72dp" />

    </LinearLayout>

    <!-- طبقة الخطأ التي تغطي الشاشة بالكامل -->
    <FrameLayout
        android:id="@+id/errorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/txtErrorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="لا يمكن الاتصال بالاستراحة"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إعادة الاتصال"
                android:textAllCaps="false"
                android:layout_marginTop="16dp"
                android:backgroundTint="#E50914"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>